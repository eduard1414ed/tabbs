{
  "manifest_version": 3,
  "name": "Tabbs",
  "description": "__MSG_extDescription__",
  "version": "1.2.0",
  "default_locale": "en",
  "permissions": [
    "sidePanel",
    "bookmarks",
    "tabs",
    "storage",
    "favicon"
  ],
  "optional_permissions": [
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/tabbs-16.png",
      "32": "icons/tabbs-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      }
    },
    "next-space": {
      "description": "__MSG_nextSpace__"
    },
    "previous-space": {
      "description": "__MSG_previousSpace__"
    }
  },
  "icons": {
    "16": "icons/tabbs-outline-16.png",
    "32": "icons/tabbs-outline-32.png",
    "48": "icons/tabbs-outline-48.png",
    "128": "icons/tabbs-outline-128.png"
  }
}
